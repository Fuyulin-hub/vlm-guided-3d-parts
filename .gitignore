# Only source, configuration, documentation, and manuscript inputs are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/scripts/
!/tests/
!/docs/
!/manuscript/
!/work/

/work/*
!/work/c-viewer/
/work/c-viewer/assets/
/work/c-viewer/qa/

/manuscript/build/
/manuscript/source_data/
/manuscript/*.pdf
/manuscript/*.zip
/manuscript/*.aux
/manuscript/*.bbl
/manuscript/*.blg
/manuscript/*.log
/manuscript/*.out
/manuscript/*.xdv
/manuscript/*.synctex.gz

**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/.venv/
**/.env
**/.env.*
**/*.pyc
**/*.pyo
**/*.key
**/*.key.pub
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/known_hosts*
**/*credential*
**/*token*.json

**/*.glb
**/*.gltf
**/*.vxz
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.bin
**/*.npy
**/*.npz
**/*.jsonl
**/*.xlsx
**/*.csv

**/.DS_Store
**/Thumbs.db
